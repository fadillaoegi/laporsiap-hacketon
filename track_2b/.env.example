POSTGRES_USER=laporsiap
POSTGRES_DB=laporsiap
POSTGRES_PASSWORD=replace-with-a-local-random-password
DATABASE_URL=postgres://laporsiap:replace-with-a-local-random-password@127.0.0.1:55432/laporsiap?sslmode=disable
LISTEN_ADDR=127.0.0.1:8787
# Hack Apertus variables (preferred). APERTUS_* below remain as fallbacks.
# LLM_NAME=swiss-ai/apertus-v1.5-70b
# LLM_BASE_URL=https://api.publicai.co/v1
# LLM_API_KEY=
# Existing Apertus env is loaded separately by scripts/dev-backend.sh.
CASE_RETENTION_DAYS=30
CASE_ACCESS_HOURS=168
MAX_CASES=200
MAX_STORAGE_BYTES=268435456
MAX_CASE_REVISIONS=200
AI_CASE_DAILY_LIMIT=3
AI_GLOBAL_DAILY_LIMIT=20
AI_CONCURRENT_LIMIT=2
REQUESTS_PER_MINUTE=240
